{
  "name": "paradox-heist",
  "private": true,
  "version": "0.1.0",
  "description": "PARADOX HEIST — a top-down action-puzzle game built on 20-second time loops.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
